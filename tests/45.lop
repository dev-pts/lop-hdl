module: test:
		A = 1
	const:
		B = 2
		C = A + B
	submodule:
		sub: SubModule
		sub2: SubModule(A = A, B = B, C = C, D = A + B)
	local:
		n: net[10]

	n = A
	n = B
	n = C

	n = sub.A
	n = sub.B
	n = sub.C
	n = sub.D
	n = sub.E

	n = n[sub.D .. 0]
	n = n[sub.E .. 0]

	n = sub2.A
	n = sub2.B
	n = sub2.C
	n = sub2.D
	n = sub2.E

	n = n[sub2.D .. 0]
	n = n[sub2.E .. 0]

module: SubModule:
		A = 1
		B = 1
		C = 1
		D = 1
	const:
		E = A + B + C + D
